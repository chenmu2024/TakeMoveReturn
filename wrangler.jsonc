{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takemovereturn",
  "workers_dev": true,
  "preview_urls": true,
  "main": "worker-entry.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://takemovereturn.com",
    "SUPABASE_AUTH_ENABLED": "true",
    "WAFFO_MERCHANT_ID": "MER_1nlEgg0UD2PNj3UGzHWgUm",
    "WAFFO_STORE_ID": "STO_41dTjcJJB7c2wSmzUpWqQr",
    "WAFFO_BILLING_ENABLED": "true",
    "CUSTOMER_FILES_ENABLED": "false"
  },
  "routes": [
    { "pattern": "takemovereturn.com/*", "zone_name": "takemovereturn.com" },
    { "pattern": "www.takemovereturn.com", "custom_domain": true }
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "takemovereturn" }],
  "queues": {
    "producers": [{ "binding": "IMPORT_QUEUE", "queue": "takemovereturn-import" }],
    "consumers": [{ "queue": "takemovereturn-import", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 5 }]
  },
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "takemovereturn-opennext-cache" }]
}
