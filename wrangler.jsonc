{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takemovereturn",
  "workers_dev": true,
  "preview_urls": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": { "NEXT_PUBLIC_SITE_URL": "https://takemovereturn.com" },
  "routes": [
    { "pattern": "takemovereturn.com/*", "zone_name": "takemovereturn.com" },
    { "pattern": "www.takemovereturn.com", "custom_domain": true }
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "takemovereturn" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "takemovereturn-opennext-cache" }]
}
